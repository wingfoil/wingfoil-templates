{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wingfoil/wingfoil-templates/index/catalog-index.schema.json",
  "title": "catalog-index.json, format 2",
  "description": "The machine index of the catalog (spec-002 §3.3), generated by npm run index. Not part of the contract with the WingFoil CLI (spec-002 §4). Format 1 is index/catalog-index.v1.schema.json, frozen; an index is read against the schema its format names.",
  "type": "object",
  "required": ["format", "repository", "install", "packs", "presets", "transitions"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 2 },
    "repository": { "const": "wingfoil/wingfoil-templates" },
    "install": { "type": "array", "items": { "$ref": "#/$defs/version" }, "uniqueItems": true },
    "packs": { "type": "array", "items": { "$ref": "#/$defs/pack" } },
    "presets": { "type": "array", "items": { "$ref": "#/$defs/preset" } },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "packId": {
      "type": "string",
      "pattern": "^(?:base|software|(?:methodology|blueprint|governance|team-mode|stage)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*|phase/(?:inception|specification|release|end-of-life)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "requiresEntry": {
      "type": "string",
      "pattern": "^(?:base|software|(?:methodology|blueprint|governance|team-mode|stage)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*|phase/(?:inception|specification|release|end-of-life)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)@(?:\\^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)?|~(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?|(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|(?:>=|>|<=|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?: (?:>=|>|<=|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))*)$"
    },
    "conflictsEntry": {
      "type": "string",
      "pattern": "^(?:base|software|(?:methodology|blueprint|governance|team-mode|stage)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*|phase/(?:inception|specification|release|end-of-life)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)(?:@(?:\\^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)?|~(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?|(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|(?:>=|>|<=|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?: (?:>=|>|<=|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))*))?$"
    },
    "url": { "type": "string", "pattern": "^https://(?:raw\\.githubusercontent\\.com|github\\.com)/wingfoil/wingfoil-templates/" },
    "names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "formats": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "enum": ["string", "integer", "boolean", "path", "pattern"] },
        "default": { "type": ["string", "integer", "boolean"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "packVersion": {
      "type": "object",
      "required": ["version", "tag", "wingfoil", "formats", "requires_capabilities", "requires",
        "conflicts", "pack_format", "readme_url", "manifest_url"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "tag": { "type": "string", "pattern": "^[a-z][a-z0-9/-]*@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" },
        "wingfoil": { "type": "string", "minLength": 1 },
        "formats": { "$ref": "#/$defs/formats" },
        "requires_capabilities": { "$ref": "#/$defs/names" },
        "requires": { "$ref": "#/$defs/names" },
        "conflicts": { "$ref": "#/$defs/names" },
        "conditional": { "type": "array", "minItems": 1, "items": { "type": "object",
          "required": ["with"], "additionalProperties": false,
          "properties": { "with": { "$ref": "#/$defs/requiresEntry" } } } },
        "pack_format": { "type": "integer", "enum": [1, 2] },
        "readme_url": { "$ref": "#/$defs/url" },
        "manifest_url": { "$ref": "#/$defs/url" }
      }
    },
    "pack": {
      "type": "object",
      "required": ["id", "catalog", "status", "axis", "slot", "latest", "versions", "title",
        "description", "workflows", "conditional_workflows", "memory_types", "directives",
        "conditional_directives", "conditional_parts", "tensions", "parameters", "excerpt",
        "profiles"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/packId" },
        "catalog": { "enum": ["official", "community"] },
        "status": { "enum": ["active", "deprecated"] },
        "axis": { "enum": [null, "methodology", "phase", "blueprint", "governance", "team-mode", "stage"] },
        "slot": { "enum": [null, "inception", "specification", "release", "end-of-life"] },
        "latest": { "$ref": "#/$defs/version" },
        "versions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packVersion" } },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "workflows": { "$ref": "#/$defs/names" },
        "conditional_workflows": { "$ref": "#/$defs/names" },
        "memory_types": { "$ref": "#/$defs/names" },
        "directives": { "$ref": "#/$defs/names" },
        "conditional_directives": { "$ref": "#/$defs/names" },
        "conditional_parts": { "type": "array", "items": { "type": "object",
          "required": ["with", "workflows", "directives"], "additionalProperties": false,
          "properties": {
            "with": { "$ref": "#/$defs/requiresEntry" },
            "workflows": { "$ref": "#/$defs/names" },
            "directives": { "$ref": "#/$defs/names" } } } },
        "tensions": { "type": "array", "items": { "type": "object",
          "required": ["pack", "resolution"], "additionalProperties": false,
          "properties": {
            "pack": { "$ref": "#/$defs/conflictsEntry" },
            "resolution": { "type": "string", "minLength": 1 } } } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "excerpt": { "type": "string", "maxLength": 500 },
        "profiles": { "$ref": "#/$defs/names" }
      }
    },
    "preset": {
      "type": "object",
      "required": ["id", "title", "description", "profile", "packs", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "profile": { "type": ["string", "null"] },
        "packs": { "$ref": "#/$defs/names" },
        "url": { "$ref": "#/$defs/url" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["id", "from", "to", "formats", "requires_capabilities", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "from": { "$ref": "#/$defs/packId" },
        "to": { "$ref": "#/$defs/packId" },
        "formats": { "$ref": "#/$defs/formats" },
        "requires_capabilities": { "$ref": "#/$defs/names" },
        "url": { "$ref": "#/$defs/url" }
      }
    }
  }
}
