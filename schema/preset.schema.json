{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wingfoil/wingfoil-templates/schema/preset.schema.json",
  "title": "WingFoil-Templates preset (presets/<id>.yaml)",
  "$comment": "Format 1, specified by spec-001 (docs/memory/tech-spec/). A change to this schema is a change of the contract with the WingFoil CLI and produces a feedback note (wingfoil-feedback directive).",
  "type": "object",
  "required": [
    "format",
    "id",
    "title",
    "description",
    "packs"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/name"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "description": "the adoption profile it serves (personas §2)"
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requiresEntry"
      },
      "uniqueItems": true
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      },
      "description": "generic values only, never project values (pack-authoring)"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "a pack name or an asset identifier (spec-001 §4, §6.1)"
    },
    "requiresEntry": {
      "type": "string",
      "pattern": "^(?:base|(?:methodology|blueprint|governance|team-mode|stage)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*|phase/(?:inception|specification|release|end-of-life)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*)@(?:\\^(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?)?|~(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?|(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)|(?:>=|>|<=|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?: (?:>=|>|<=|<)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*))*)$",
      "description": "<catalog pack id>@<range> (spec-001 §6.3)"
    }
  }
}
