{
  "name": "wingfoil-templates",
  "version": "0.0.0",
  "private": true,
  "description": "Official template packs (methodologies, overlays, phase methods, blueprints, stages) downloaded by the WingFoil CLI.",
  "license": "MIT",
  "author": "Roberto Pompermaier <robypomper@gmail.com>",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "lint": "eslint --max-warnings 0 .",
    "check:pins": "node dist/src/check-pins.js",
    "check:schemas": "node dist/src/check-schemas.js",
    "check:packs": "node dist/src/check-packs-cli.js",
    "check:runs": "node dist/src/runs-cli.js",
    "compose": "node dist/src/compose-cli.js",
    "digest": "node dist/src/digest-cli.js",
    "validate": "node dist/src/validate-cli.js",
    "validate:publication": "node dist/src/validate-publication-cli.js",
    "publish:pack": "node dist/src/publish-cli.js",
    "feedback:note": "node dist/src/feedback-note-cli.js",
    "index": "node dist/src/index-cli.js",
    "intake:detect": "node dist/src/intake-detect-cli.js",
    "intake:prepare": "node dist/src/intake-prepare-cli.js",
    "intake:collect": "node dist/src/intake-artifact-cli.js collect",
    "intake:apply": "node dist/src/intake-artifact-cli.js apply",
    "intake:rehearse": "node dist/src/intake-rehearsal-cli.js",
    "intake:report": "node dist/src/intake-report-cli.js",
    "site": "node dist/src/site-cli.js",
    "wingfoil": "wingfoil"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "wingfoil": "0.2.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
