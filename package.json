{
  "name": "wingfoil-templates",
  "version": "0.0.0",
  "private": true,
  "description": "Official template packs (methodologies, overlays, phase methods, blueprints, stages) downloaded by the WingFoil CLI.",
  "license": "MIT",
  "author": "Roberto Pompermaier <robypomper@gmail.com>",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "check:pins": "node dist/src/check-pins.js",
    "wingfoil": "wingfoil"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "typescript": "6.0.3",
    "wingfoil": "0.2.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  }
}
